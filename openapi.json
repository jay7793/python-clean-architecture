                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sign In At",
            "description": "null when the user never signed in"
          },
          "protected": {
            "type": "boolean",
            "title": "Protected",
            "description": "An admin can see this account but not edit, delete or sign it out"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "first_name",
          "last_name",
          "created_at",
          "updated_at",
          "role",
          "session",
          "last_sign_in_at",
          "protected"
        ],
        "title": "AdminUserOverview"
      },
